# OpenAI-compatible chat completions endpoint.
# Defaults in docker-compose point at the local mock, which streams for ~25s.
# The bundled Ollama service is http://ollama:11434/v1 (published on host port 11436).
# AI_BASE_URL=http://ollama:11434/v1
# AI_MODEL=llama3.2:1b
AI_BASE_URL=http://ollama:11434/v1
AI_MODEL=llama3.2:1b
AI_API_KEY=ollama
